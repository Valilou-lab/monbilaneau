# "false" disables demo partners (Culligan / Kinetico) once real buyers are configured.
NEXT_PUBLIC_DEMO_MODE=true

# Formulaire « Devenir partenaire » (Resend — server-only, never commit the key)
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Mon Bilan Eau <partenaires@monbilaneau.fr>"
CONTACT_FROM=
CONTACT_TO=contact@valeadata.com
